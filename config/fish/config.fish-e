alias nvim="~/nvim-macos/bin/nvim"
alias ll='lsd -lAt --group-dirs first' 
alias ls='lsd --group-dirs first' 
alias tree='lsd --tree --group-dirs first'
alias cls='clear'
alias python='python3'
alias pip='python3 -m pip'
alias dotfiles='git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
alias nv='nvim .'
alias gtree='git log --oneline --all --graph --decorate'

function fish_greeting
end

function fish_prompt -d "Write out the prompt"
    set -g __fish_git_prompt_showdirtystate yes
    # set -g __fish_git_prompt_showcolorhints yes
    # set -g __fish_git_prompt_show_informative_status yes
    set -g __fish_git_prompt_showupstream verbose
    printf '%s%s%s %s~ ' (set_color $fish_color_cwd) (prompt_pwd) \
        (set_color normal) (fish_git_prompt)
end

if status is-interactive
    # Commands to run in interactive sessions can go here
end

# ASDF configuration code
if test -z $ASDF_DATA_DIR
    set _asdf_shims "$HOME/.asdf/shims"
else
    set _asdf_shims "$ASDF_DATA_DIR/shims"
end

# Do not use fish_add_path (added in Fish 3.2) because it
# potentially changes the order of items in PATH
if not contains $_asdf_shims $PATH
    set -gx --prepend PATH $_asdf_shims
end
set --erase _asdf_shims



# BEGIN opam configuration
# This is useful if you're using opam as it adds:
#   - the correct directories to the PATH
#   - auto-completion for the opam binary
# This section can be safely removed at any time if needed.
test -r '/Users/chema/.opam/opam-init/init.fish' && source '/Users/chema/.opam/opam-init/init.fish' > /dev/null 2> /dev/null; or true
# END opam configuration
