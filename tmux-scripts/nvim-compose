#!/usr/bin/env bash
#
# nvim-compose — open nvim in a tmux popup to compose text, then paste it
# into the original pane. Useful for writing multi-line prompts when using
# CLI-based AI agents (Cursor, Claude Code, etc.).
#
# SETUP
# -----
# Add the following to your ~/.tmux.conf:
#
#   # Normal mode — open an empty compose editor
#   bind-key -n C-g run-shell "~/dotfiles/tmux-scripts/nvim-compose"
#
#   # Copy-mode (vi) — grab the selection and open compose with it pre-filled
#   bind-key -T copy-mode-vi C-g send-keys -X copy-pipe-and-cancel "~/dotfiles/tmux-scripts/nvim-compose --from-stdin"
#
# Then reload tmux config:
#
#   tmux source-file ~/.tmux.conf
#
# Ctrl-g (no prefix needed) will open a floating editor popup. Write your
# text, save and quit, and it gets pasted into the pane you came from.
#
# If you press Ctrl-g while in tmux copy-mode (vi) with text selected, the
# selection is piped into the editor so you can edit it before pasting.
#
# REQUIREMENTS
# ------------
# - tmux 3.2+ (for popup support)
# - nvim
#

TMPFILE=$(mktemp /tmp/nvim-compose-XXXXXX.md)
trap 'rm -f "$TMPFILE"' EXIT

PANE_ID=$(tmux display-message -p '#{pane_id}')

NVIM_ARGS=()

if [ "$1" = "--from-stdin" ]; then
  cat > "$TMPFILE"
else
  NVIM_ARGS+=("-c" "startinsert")
fi

tmux popup -w 80% -h 80% -E "nvim ${NVIM_ARGS[*]} '$TMPFILE'"

if [ -s "$TMPFILE" ]; then
  tmux load-buffer "$TMPFILE"
  tmux paste-buffer -t "$PANE_ID" -dp
fi
